# Salin file ini menjadi ".env" (tanpa .example) lalu isi nilainya.
# Jangan pakai tanda kutip.

# URL endpoint flow: di Langflow buka flow > tombol "API" > salin alamat POST .../api/v1/run/<id-atau-nama>
LANGFLOW_URL=http://localhost:7860/api/v1/run/35a26c4b-ebaf-4cac-a624-70c747e810cd
# API key: Langflow > Settings > Langflow API Keys > Add New
LANGFLOW_API_KEY=YOUR_API_KEY_HERE
LANGFLOW_TIMEOUT=180

# --- OPSIONAL ---
# ID komponen dideteksi otomatis; isi hanya jika deteksi gagal
FILE_NODE_ID=
ANAMNESIS_NODE_ID=
# UUID flow (hanya jika nama endpoint tidak terbaca)
LANGFLOW_FLOW_ID=
# Percobaan ulang saat Gemini overload (detik) & model cadangan
RETRY_WAITS=5,10,20
FALLBACK_MODELS=gemini-2.5-flash-lite
# Jika jawaban AI sering terpotong: paksa batas token output Agent (mis. 8192). 0 = jangan ubah.
AGENT_MAX_TOKENS=0
# Batas karakter teks PDF yang dikirim ke AI
MAX_LAB_CHARS=12000
